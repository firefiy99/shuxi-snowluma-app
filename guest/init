#!/bin/sh
# initramfs /init — 挂载持久磁盘后进入 guest 系统
set -u

export PATH=/bin:/sbin:/usr/bin:/usr/sbin

mount -t proc proc /proc 2>/dev/null || true
mount -t sysfs sysfs /sys 2>/dev/null || true
mount -t devtmpfs devtmpfs /dev 2>/dev/null || true

# devtmpfs 可能不自动填充，按 sysfs 的主次设备号补建 /dev/vda
if [ ! -b /dev/vda ]; then
  DEV=$(cat /sys/block/vda/dev 2>/dev/null || true)
  if [ -n "${DEV:-}" ]; then
    MAJ=${DEV%%:*}
    MIN=${DEV##*:}
    mknod /dev/vda b "$MAJ" "$MIN" 2>/dev/null || true
  fi
fi

echo "[init] waiting for /dev/vda ..."
i=0
while [ ! -b /dev/vda ] && [ $i -lt 50 ]; do
  sleep 0.2
  i=$((i+1))
done

if [ ! -b /dev/vda ]; then
  echo "[init] FATAL: /dev/vda not found"
  exec sh
fi

NEWROOT=/newroot
mkdir -p "$NEWROOT"

echo "[init] mounting root filesystem"
if ! mount -t ext4 -o rw /dev/vda "$NEWROOT"; then
  echo "[init] FATAL: cannot mount /dev/vda (filesystem may need e2fsck)"
  exec sh
fi

mkdir -p "$NEWROOT/proc" "$NEWROOT/sys" "$NEWROOT/dev" "$NEWROOT/dev/pts" \
         "$NEWROOT/dev/shm" "$NEWROOT/tmp" "$NEWROOT/run" "$NEWROOT/var/log"

mount --bind /proc "$NEWROOT/proc" 2>/dev/null || mount -t proc proc "$NEWROOT/proc" 2>/dev/null || true
mount --bind /sys "$NEWROOT/sys" 2>/dev/null || mount -t sysfs sysfs "$NEWROOT/sys" 2>/dev/null || true
mount --bind /dev "$NEWROOT/dev" 2>/dev/null || mount -t devtmpfs devtmpfs "$NEWROOT/dev" 2>/dev/null || true
mount -t devpts devpts "$NEWROOT/dev/pts" 2>/dev/null || true
mount -t tmpfs -o size=1024m,mode=1777 tmpfs "$NEWROOT/dev/shm" 2>/dev/null || true
mount -t tmpfs -o size=768m,mode=1777 tmpfs "$NEWROOT/tmp" 2>/dev/null || true
mount -t tmpfs -o size=256m,mode=755 tmpfs "$NEWROOT/run" 2>/dev/null || true

cp /etc/resolv.conf "$NEWROOT/etc/resolv.conf" 2>/dev/null || true

echo "[init] entering guest"
exec chroot "$NEWROOT" /opt/boot.sh
